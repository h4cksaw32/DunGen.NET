<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:DunGenApp;assembly=DunGenApp"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="DunGenApp.TextureEditor"
        Title="Textures"
		FontSize="12">
	<ScrollViewer>
		<StackPanel Name="Disp" Margin="10" x:DataType="local:TextureInfo">
			<StackPanel.Styles>
				<Style Selector="TextBlock">
					<Setter Property="VerticalAlignment" Value="Center"/>
				</Style>
			</StackPanel.Styles>
			<WrapPanel>
				<TextBlock Text="Tile size: " VerticalAlignment="Center"/>
				<TextBox Text="{Binding TileSize}"/>
			</WrapPanel>
		</StackPanel>
	</ScrollViewer>
</Window>
